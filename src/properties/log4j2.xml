<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{YYYY-MM-dd HH:mm:ss} [%t] %-5p %c{1}:%L - %msg%n" />
       </Console>
    </Appenders>
    <Loggers>
        <Root level="all">
            <AppenderRef ref="console" level="all" />
        </Root>
    </Loggers>
</Configuration>